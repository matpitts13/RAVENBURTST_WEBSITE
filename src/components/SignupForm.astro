---
// The mailing-list signup. Posts to /api/subscribe (a Cloudflare Pages
// Function); works as a plain form without JavaScript, and with it shows
// the result inline instead of navigating away.
interface Props {
  id?: string
  source?: string // which page/section, stored with the signup
}
const { id = 'signup', source = 'site' } = Astro.props
---
<form id={id} action="/api/subscribe" method="post" class="rb-signup w-full" data-source={source} novalidate>
  <div class="flex flex-col sm:flex-row gap-3">
    <label for={`${id}-email`} class="sr-only">Email address</label>
    <input id={`${id}-email`} type="email" name="email" placeholder="you@example.com" required autocomplete="email"
      class="flex-1 bg-rb-surface border border-rb-border rounded-lg px-4 py-3 text-rb-text placeholder:text-rb-muted outline-none focus:border-rb-accent transition-colors" />
    <!-- Bots fill every field; people never see this one. -->
    <div aria-hidden="true" class="absolute -left-[9999px]">
      <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="source" value={source} />
    <button type="submit"
      class="bg-rb-accent hover:bg-rb-accent-hv disabled:opacity-60 text-white px-6 py-3 rounded-lg font-medium transition-colors whitespace-nowrap">
      Join the list
    </button>
  </div>
  <p class="rb-signup-msg text-sm mt-3 min-h-[1.25rem]" role="status" aria-live="polite"></p>
  <p class="text-xs text-rb-muted mt-1">
    One email when the Kickstarter launches, and the occasional update. Unsubscribe any time.
    See the <a href="/legal/privacy" class="underline hover:text-rb-text">privacy policy</a>.
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.rb-signup')) {
    if (form.dataset.bound) continue
    form.dataset.bound = '1'
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const msg = form.querySelector<HTMLElement>('.rb-signup-msg')!
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
      const email = form.querySelector<HTMLInputElement>('input[name=email]')!
      if (!email.checkValidity()) {
        msg.textContent = 'Please enter a valid email address.'
        msg.className = 'rb-signup-msg text-sm mt-3 min-h-[1.25rem] text-rb-amber'
        email.focus()
        return
      }
      button.disabled = true
      msg.textContent = 'Signing you up…'
      msg.className = 'rb-signup-msg text-sm mt-3 min-h-[1.25rem] text-rb-muted'
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        const data = await res.json().catch(() => ({}))
        if (!res.ok) {
          // The server's own wording when it gave one; otherwise generic.
          msg.textContent = data.message || 'Something went wrong. Please try again in a moment.'
          msg.className = 'rb-signup-msg text-sm mt-3 min-h-[1.25rem] text-rb-amber'
          return
        }
        msg.textContent = data.message || 'Check your inbox to confirm your address.'
        msg.className = 'rb-signup-msg text-sm mt-3 min-h-[1.25rem] text-rb-green'
        form.reset()
      } catch {
        // Network failure: the browser's own text ("Failed to fetch") means nothing to people.
        msg.textContent = 'Couldn’t reach the server. Check your connection and try again.'
        msg.className = 'rb-signup-msg text-sm mt-3 min-h-[1.25rem] text-rb-amber'
      } finally {
        button.disabled = false
      }
    })
  }
</script>
