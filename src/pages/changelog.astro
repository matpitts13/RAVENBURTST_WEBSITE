---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const releases = [
  {
    version: 'v1.0.0-beta.3',
    date: 'October 2026 · beta',
    items: [
      'Tabletop Adventure and Tabletop Campaign projects, with their own left bar for encounters, creatures, characters, maps, locations, items, handouts, tables and sessions',
      'Prep pages as cards with their name on them; link any page with @ and see where each one is used',
      'Encounters with live difficulty for your party',
      'Encounter maps: draw or generate, doors, traps and secrets, a GM map and a player map, and table-size printing',
      'Character sheets: full or quick NPC, for 5e or any game',
      'Item sheets, your own bestiary, sheet templates and item compendium, and printable item cards',
      'Roll tables, read-aloud boxes, GM notes, cross-references and a two-column adventure PDF',
      'Take your custom dictionary and tabletop library to another computer',
      'Ravenburst now opens on the project picker; pin projects to the top',
      'New projects: choose the type first, then name and save it',
      'An update button in the top-right corner when a new version is ready',
      'A trash icon on every row in the left bar, and a + on chapters and parts for a new scene',
      'Every confirmation and error message now uses Ravenburst\u2019s own window',
      'Right-click menus stay on screen near the window edges',
    ],
  },
  {
    version: 'v1.0.0',
    date: 'Coming with the Kickstarter',
    items: [
      'Rich-text editor with footnotes, inline notes, tables, images and resume notes',
      'Navigator with Manuscript, Front and Back Matter, Characters, Places, Notes, Reference, Template Sheets and Trash',
      'Corkboard, outline, split view and a second window',
      '17 project templates: prose, picture books, academic papers, screen, stage and tabletop',
      'Compile to manuscript, paperback and proof, screenplay and documentary, US and UK stage play, EPUB, children’s book, APA, MLA and Chicago',
      'Import from Word, Markdown, plain text and Fountain',
      'Snapshots, automatic Git backup and project trash',
      'Targets, statistics and writing history',
      'Light, dark and high-contrast themes; interface text size up to 150%',
      'Windows, macOS and Linux',
    ],
  },
]
---
<Base title="Changelog" description="What’s new in each version of Ravenburst.">
  <Nav />
  <main id="main" class="pt-32 pb-20 px-6 max-w-3xl mx-auto">
    <h1 class="text-4xl font-serif font-bold mb-12">Changelog</h1>
    {releases.map(r => (
      <section class="mb-12" aria-labelledby={`v-${r.version}`}>
        <div class="flex items-baseline gap-4 mb-6">
          <h2 id={`v-${r.version}`} class="text-2xl font-serif font-semibold">{r.version}</h2>
          <span class="text-rb-muted text-sm">{r.date}</span>
        </div>
        <ul class="space-y-2">
          {r.items.map(item => (
            <li class="flex gap-3 text-rb-muted">
              <span class="text-rb-green" aria-hidden="true">+</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <Footer />
</Base>
