---
import DocsLayout from '../../layouts/DocsLayout.astro'
import { DOCS_NAV } from '../../data/docsNav'
---
<DocsLayout title="Documentation" description="The Ravenburst documentation: getting started, writing, compiling and exporting, backups, settings and troubleshooting.">
  <h1>Ravenburst Documentation</h1>
  <p class="lede">How everything in Ravenburst works. New here? Start with <a href="/docs/getting-started">First Launch</a>.</p>

  {DOCS_NAV.map((s) => (
    <section>
      <h2>{s.heading}</h2>
      <div class="not-prose grid sm:grid-cols-2 gap-3 mb-2">
        {s.links.filter((l) => l.href !== '/docs').map((l) => (
          <a href={l.href} class="block bg-rb-surface border border-rb-border rounded-xl p-4 no-underline hover:border-rb-accent transition-colors" style="text-decoration:none">
            <span class="block font-semibold text-rb-text mb-1">{l.label}</span>
            <span class="block text-sm text-rb-muted leading-relaxed">{l.blurb}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <div class="note">
    <p><strong>On a Mac?</strong> These pages show Windows keys. Use <kbd>⌘</kbd> for <kbd>Ctrl</kbd> and <kbd>⌥ Option</kbd> for <kbd>Alt</kbd>.</p>
  </div>
</DocsLayout>
