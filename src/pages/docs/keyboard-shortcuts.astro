---
import DocsLayout from '../../layouts/DocsLayout.astro'
// Mirrors the app's own list (Help → Keyboard Shortcuts, ShortcutsPanel.tsx
// in the app repo), which a test there keeps in step with the menus.
const shortcuts: { section: string; items: [string, string][] }[] = [
  {
    section: 'File',
    items: [
      ['Ctrl+N', 'New Document'],
      ['Ctrl+Shift+N', 'New Project'],
      ['Ctrl+Shift+D', 'New Chapter Folder'],
      ['Ctrl+O', 'Open Project'],
      ['Ctrl+S', 'Save'],
      ['Ctrl+Shift+S', 'Save as Snapshot'],
      ['Ctrl+Shift+E', 'Compile / Export'],
      ['Ctrl+P', 'Print'],
      ['Ctrl+,', 'Preferences'],
    ],
  },
  {
    section: 'Edit',
    items: [
      ['Ctrl+Z', 'Undo'],
      ['Ctrl+Shift+Z', 'Redo'],
      ['Ctrl+X', 'Cut'],
      ['Ctrl+C', 'Copy'],
      ['Ctrl+V', 'Paste'],
      ['Ctrl+Shift+V', 'Paste and Match Style'],
      ['Ctrl+A', 'Select All'],
      ['Ctrl+F', 'Find in Document'],
      ['Ctrl+G', 'Find Next'],
      ['Ctrl+Shift+G', 'Find Previous'],
      ['Ctrl+H', 'Find & Replace'],
      ['Ctrl+Shift+F', 'Find in Project'],
      ['Esc', 'Close the find bar'],
    ],
  },
  {
    section: 'Character formatting',
    items: [
      ['Ctrl+B', 'Bold'],
      ['Ctrl+I', 'Italic'],
      ['Ctrl+U', 'Underline'],
      ['Ctrl+Shift+X', 'Strikethrough'],
      ['Ctrl+Shift+=', 'Superscript'],
      ['Ctrl+Shift+-', 'Subscript'],
      ['Ctrl+\\', 'Clear Formatting'],
    ],
  },
  {
    section: 'Paragraph formatting',
    items: [
      ['Ctrl+Shift+L', 'Align Left'],
      ['Ctrl+Shift+C', 'Align Center'],
      ['Ctrl+Shift+R', 'Align Right'],
      ['Ctrl+Shift+J', 'Justify'],
      ['Ctrl+Shift+8', 'Bullet List'],
      ['Ctrl+Shift+7', 'Numbered List'],
      ['Tab', 'Indent the first line (or nest a list item)'],
      ['Shift+Tab', 'Remove the indent (or un-nest a list item)'],
      ['Ctrl+Alt+1', 'Heading 1'],
      ['Ctrl+Alt+2', 'Heading 2'],
      ['Ctrl+Alt+3', 'Heading 3'],
    ],
  },
  {
    section: 'Insert',
    items: [
      ['Ctrl+Shift+K', 'Inline Comment / Note'],
      ['Ctrl+Shift+B', 'Resume Note (pick up here)'],
      ['Ctrl+Alt+F', 'Footnote'],
    ],
  },
  {
    section: 'View',
    items: [
      ['Ctrl+=', 'Zoom In'],
      ['Ctrl+-', 'Zoom Out'],
      ['Ctrl+0', 'Reset Zoom (100%)'],
      ['Ctrl+1', 'Single Document'],
      ['Ctrl+2', 'Split View'],
      ['Ctrl+3', 'Split Window'],
      ['Ctrl+4', 'Corkboard'],
      ['Ctrl+5', 'Outline'],
      ['Ctrl+Shift+[', 'Show / Hide Navigator'],
      ['Ctrl+Shift+]', 'Show / Hide Inspector'],
      ['F11', 'Fullscreen / Composition Mode (Ctrl+⌘+F on a Mac)'],
    ],
  },
  {
    section: 'Navigate',
    items: [
      ['Ctrl+[', 'Previous Document'],
      ['Ctrl+]', 'Next Document'],
      ['Alt+←', 'Back (⌘+⌥+← on a Mac)'],
      ['Alt+→', 'Forward (⌘+⌥+→ on a Mac)'],
      ['Ctrl+Shift+M', 'Jump to Manuscript'],
      ['Ctrl+D', 'Add Bookmark'],
    ],
  },
  {
    section: 'Project & window',
    items: [
      ['Ctrl+Alt+T', 'Project Targets'],
      ['Ctrl+Alt+[', 'Move Navigator Left'],
      ['Ctrl+Alt+]', 'Move Navigator Right'],
      ['Ctrl+M', 'Minimize'],
      ['Ctrl+Shift+/', 'Keyboard Shortcuts'],
    ],
  },
]
---
<DocsLayout title="Keyboard Shortcuts" description="Every Ravenburst keyboard shortcut in one place, for Windows, Linux and macOS.">
  <h1>Keyboard Shortcuts</h1>
  <p class="lede">Shown for Windows and Linux. On a Mac, use <kbd>⌘ Cmd</kbd> in place of <kbd>Ctrl</kbd> and <kbd>⌥ Option</kbd> in place of <kbd>Alt</kbd>, except where noted.</p>
  <p>In the app, <span class="menu">Help → Keyboard Shortcuts</span> (<kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>/</kbd>) shows this list, with your computer's own keys.</p>

  {shortcuts.map((group) => (
    <section>
      <h2>{group.section}</h2>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{group.section} shortcuts</caption>
          <thead><tr><th scope="col">Keys</th><th scope="col">Action</th></tr></thead>
          <tbody>
            {group.items.map(([key, action]) => (
              <tr><td><kbd>{key}</kbd></td><td>{action}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <h2>Mouse and other keys</h2>
  <ul>
    <li><kbd>Ctrl</kbd> + mouse wheel zooms the editor.</li>
    <li>Double-click the zoom percentage in the status bar to go back to 100%.</li>
    <li>In the Navigator, <kbd>F2</kbd> or a double-click renames the selected item.</li>
    <li><kbd>Esc</kbd> closes any dialog and leaves Composition Mode.</li>
    <li>In a table, <kbd>Enter</kbd> moves to the cell below.</li>
  </ul>
</DocsLayout>
