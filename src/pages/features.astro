---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import SignupForm from '../components/SignupForm.astro'

// Every item here is checked against the app's menus and dialogs.
// Hidden or unfinished features are deliberately left out.
const groups = [
  {
    heading: 'Write',
    items: [
      { title: 'A real rich-text editor', body: 'Bold, italic, underline, strikethrough, superscript and subscript; three heading levels, block quotes, alignment, line spacing, lists, font and highlight colour.' },
      { title: 'Footnotes and inline notes', body: 'Add footnotes as you go, and leave yourself inline comments that never end up in the exported book.' },
      { title: 'Pick up where you left off', body: 'Drop a resume note at the exact spot you stopped, and Ravenburst takes you straight back to it next time.' },
      { title: 'Tables and images', body: 'Insert tables and resizable images, page breaks, scene breaks, special characters, and the current date or time in US or European style.' },
      { title: 'Spelling, your way', body: 'Spellcheck with a custom dictionary for every invented name and place, plus cleanup tools for double spaces, stray empty lines and struck-through text.' },
      { title: 'Find in the whole project', body: 'Find and replace that keeps your formatting, and a project-wide search across every document.' },
    ],
  },
  {
    heading: 'Organise',
    items: [
      { title: 'Everything in its place', body: 'Manuscript (parts, chapters and scenes), front and back matter, characters, places, notes, reference and template sheets — all in the navigator, all in one file.' },
      { title: 'Reference tables', body: 'Keep timelines, family trees and research in tables, several to a page, with your own cell colours and borders.' },
      { title: 'Corkboard and outline', body: 'See every scene as a card and drag to reorder, or scan the whole book in outline.' },
      { title: 'Split view and a second window', body: 'Write in one document while reading another side by side — or pull it into its own window on a second screen.' },
      { title: 'Chapters, named your way', body: 'Call them chapters, acts, tomes or anything else; choose the separator and an ornament for chapter titles, and Ravenburst numbers them for you.' },
      { title: 'Bookmarks and history', body: 'Bookmark the places you return to, and step back and forward through where you’ve been, like a browser.' },
    ],
  },
  {
    heading: 'Stay on track',
    items: [
      { title: 'Word counts everywhere', body: 'For the document and the whole project in the status bar, with a per-chapter breakdown when you want the detail.' },
      { title: 'Targets', body: 'Set a target for the project and see your progress toward it as you write.' },
      { title: 'Writing history', body: 'A day-by-day record of how much you wrote, so you can see your streaks and slumps.' },
      { title: 'Statistics', body: 'Words, characters, sentences and paragraphs, average sentence length, estimated pages and reading time.' },
    ],
  },
  {
    heading: 'Keep it safe',
    items: [
      { title: 'Snapshots', body: 'Save a named snapshot of any document with Ctrl+Shift+S, then preview and restore any of them whenever you like.' },
      { title: 'Automatic Git backup', body: 'Backs up the whole project every 30 minutes (or 15, 60 or 120) and whenever you quit — to a folder, a drive, or a Git host such as GitHub. Restore any earlier version as a new file.' },
      { title: 'Trash, not delete', body: 'Deleted documents go to the project’s trash first, so a slip of the mouse is never the end of a chapter.' },
      { title: 'Google Drive (test feature)', body: 'Back up to your own Google Drive with version history. It’s an early test feature: you sync by hand, and we recommend keeping another backup alongside it.' },
    ],
  },
  {
    heading: 'Publish',
    items: [
      { title: 'Start from the right template', body: 'Fifteen project templates set up the structure and formatting for you: novel, non-fiction, short story, three picture-book shapes, APA, MLA and Chicago papers, screenplay, TV script, documentary, US and UK stage plays — or start blank.' },
      { title: 'Compile to every format', body: 'Manuscript (PDF or Word), paperback in 5×7 and 6×9 with matching proofs (crop marks and bleed), screenplay and documentary (PDF or Fountain), US and UK stage plays, EPUB, three picture-book shapes, and APA, MLA and Chicago papers (PDF or Word).' },
      { title: 'Front and back matter', body: 'Title page, copyright and the rest, written once and placed correctly in every format.' },
      { title: 'Bring your work with you', body: 'Import from Word (.docx), Markdown, plain text and Fountain screenplays.' },
      { title: 'Academic styles that stay current', body: 'When a new edition of APA or MLA ships, check for format updates from the Help menu and apply them in one step.' },
    ],
  },
  {
    heading: 'Make it yours',
    items: [
      { title: 'Light, dark and high contrast', body: 'Or follow your system. High contrast is built for low-vision writers, not bolted on.' },
      { title: 'Text size for the interface', body: 'Scale every menu, panel and label to 115%, 130% or 150% — separately from your writing’s own font size.' },
      { title: 'Fullscreen composition', body: 'Hide everything but the page when it’s time to write.' },
      { title: 'Keyboard first', body: 'Shortcuts for everything you do often, and a full list one keystroke away (Ctrl+Shift+/).' },
    ],
  },
]
---
<Base title="Features" description="Everything Ravenburst does: a rich-text editor, corkboard and outline, characters and places, snapshots and automatic backup, and export to manuscript, paperback, screenplay, stage play and EPUB.">
  <Nav />
  <main id="main" class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Built for writers who mean it.</h1>
      <p class="text-rb-muted text-xl max-w-2xl mx-auto">
        Everything you need to take a book from first note to finished file — and nothing that gets between you and the page.
      </p>
    </div>

    {groups.map(g => (
      <section class="mb-16" aria-labelledby={`g-${g.heading}`}>
        <h2 id={`g-${g.heading}`} class="text-2xl font-serif font-bold mb-6 pb-3 border-b border-rb-border">{g.heading}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {g.items.map(f => (
            <div class="bg-rb-surface border border-rb-border rounded-xl p-6">
              <h3 class="font-semibold text-rb-text mb-2 font-sans">{f.title}</h3>
              <p class="text-rb-muted text-sm leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-20 max-w-md mx-auto text-center">
      <h2 class="text-2xl font-serif font-bold mb-3">Want it first?</h2>
      <p class="text-rb-muted mb-6">We’ll email you when the Kickstarter launches.</p>
      <SignupForm id="signup-features" source="features" />
    </section>
  </main>
  <Footer />
</Base>
