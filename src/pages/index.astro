---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import SignupForm from '../components/SignupForm.astro'

const pillars = [
  {
    icon: '📁',
    title: 'Your whole book in one file',
    body: 'Parts, chapters and scenes alongside your characters, places, notes, research tables, front and back matter. One .ravenburst file you can copy, back up and take anywhere.',
  },
  {
    icon: '🗂️',
    title: 'See the shape of the story',
    body: 'Rearrange scenes on the corkboard, scan them in outline, or write in one document while reading another in split view or a second window.',
  },
  {
    icon: '🛡️',
    title: 'Never lose a word',
    body: 'Named snapshots of any document, and automatic Git backup every 30 minutes and whenever you quit. Restore an earlier version without leaving the app.',
  },
]

const formats = [
  ['📄', 'Manuscript', 'Standard submission format, PDF or Word'],
  ['📚', 'Paperback', 'Print-ready 5×7 and 6×9'],
  ['🎬', 'Screenplay', 'Film, TV and documentary'],
  ['🎭', 'Stage Play', 'US and UK formats'],
  ['📱', 'EPUB', 'For e-readers and online stores'],
  ['🖼️', "Children's Book", 'Square, portrait and landscape'],
  ['🎓', 'Academic', 'APA, MLA and Chicago'],
  ['🖨️', 'Proof PDF', 'With crop marks and bleed'],
]
---
<Base title="Ravenburst">
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="pt-36 pb-20 px-6 max-w-6xl mx-auto grid md:grid-cols-[1fr_auto] gap-12 items-center">
      <div>
        <div class="inline-block bg-rb-surface border border-rb-border text-rb-muted text-xs px-3 py-1 rounded-full mb-8 tracking-wide">
          Coming soon to Kickstarter
        </div>
        <h1 class="text-5xl md:text-7xl font-serif font-bold mb-6 leading-tight">
          Your story.<br/>
          <span class="text-gradient">Your words.</span>
        </h1>
        <p class="text-xl text-rb-muted max-w-2xl mb-10 leading-relaxed">
          Ravenburst is a desktop writing studio for novelists, screenwriters and playwrights.
          Plan it, write it, and export it ready to submit, print or publish — all from one place,
          with no subscription and no account.
        </p>
        <div class="max-w-xl" id="join">
          <SignupForm id="signup-hero" source="home-hero" />
        </div>
      </div>
      <img src="/brand/raven.svg" alt="The Ravenburst raven: a raven in a top hat and monocle above a fountain pen"
        width="340" height="394" class="hidden md:block w-[300px] lg:w-[340px] h-auto opacity-95" />
    </section>

    <!-- Three pillars -->
    <section class="py-20 px-6 border-t border-rb-border" aria-labelledby="pillars">
      <h2 id="pillars" class="sr-only">Why Ravenburst</h2>
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-8">
        {pillars.map(f => (
          <div class="bg-rb-surface border border-rb-border rounded-2xl p-8">
            <div class="text-4xl mb-4" aria-hidden="true">{f.icon}</div>
            <h3 class="text-lg font-semibold text-rb-text mb-3 font-serif">{f.title}</h3>
            <p class="text-rb-muted leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Stays out of your way -->
    <section class="py-20 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-serif font-bold mb-6">Built to stay out of your way.</h2>
        <p class="text-lg text-rb-muted leading-relaxed">
          No autocorrect rewriting your character names. No autocomplete guessing your next word.
          No feed, no account, no cloud you have to trust. Ravenburst works offline, keeps everything in a
          file on your own computer, and puts the writing first — with fullscreen composition mode for
          when you want nothing else on screen.
        </p>
      </div>
    </section>

    <!-- Formats -->
    <section class="py-20 px-6 border-t border-rb-border">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-serif font-bold text-center mb-4">One project. Every format.</h2>
        <p class="text-rb-muted text-center mb-12 max-w-xl mx-auto">
          Compile your manuscript for an agent, a printer, a stage or an e-reader without reformatting a thing.
        </p>
        <ul class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {formats.map(([icon, name, sub]) => (
            <li class="bg-rb-surface border border-rb-border rounded-xl p-5 text-center">
              <div class="text-2xl mb-2" aria-hidden="true">{icon}</div>
              <div class="text-sm font-semibold text-rb-text">{name}</div>
              <div class="text-xs text-rb-muted mt-1">{sub}</div>
            </li>
          ))}
        </ul>
        <p class="text-center mt-8"><a href="/features" class="text-rb-accent hover:underline">See everything Ravenburst does →</a></p>
      </div>
    </section>

    <!-- Pricing teaser -->
    <section class="py-20 px-6 border-t border-rb-border">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-3xl font-serif font-bold mb-4">Buy it once. Own it.</h2>
        <p class="text-rb-muted mb-8 leading-relaxed">
          Ravenburst will be a one-time purchase — no subscription, ever. Kickstarter backers get it first,
          with free upgrades through version 3.
        </p>
        <a href="/pricing"
          class="inline-block border border-rb-border hover:border-rb-text text-rb-text px-8 py-4 rounded-xl font-semibold transition-colors">
          See pricing →
        </a>
      </div>
    </section>

    <!-- Join -->
    <section class="py-20 px-6 border-t border-rb-border">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-2xl font-serif font-bold mb-3">Be first when it launches.</h2>
        <p class="text-rb-muted mb-8">
          Join the list and we’ll email you the day the Kickstarter goes live. Backers get free upgrades through version 3.
        </p>
        <SignupForm id="signup-footer" source="home-bottom" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
