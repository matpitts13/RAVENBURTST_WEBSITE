---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import SignupForm from '../components/SignupForm.astro'

const included = [
  'Unlimited projects',
  'Every export format — manuscript, paperback, screenplay, stage play, EPUB, children’s book, APA and MLA',
  'Snapshots and automatic Git backup',
  'Works offline — your files stay on your computer',
  'Use it on up to 3 of your computers',
  'Free updates through version 2',
]

const faqs: [string, string][] = [
  ['When can I get it?', 'Ravenburst launches on Kickstarter first. Join the list and we’ll email you the day the campaign goes live; backers get it before anyone else.'],
  ['Is it really a one-time price?', 'Yes. You buy it once and it’s yours: no subscription, no monthly fee, no account to keep paying for.'],
  ['What do Kickstarter backers get?', 'Free upgrades through version 3, plus every patch along the way — a thank-you for backing it early.'],
  ['How do upgrades work after that?', 'Version 1 buyers get version 2 free. When a future major version ships, upgrading will cost a small fee (around $10–15) — and it’s never forced: the version you own keeps working.'],
  ['Can I try it first?', 'Yes. When Ravenburst is on sale there’s a 7-day free trial with nothing to sign up for.'],
  ['Do I need an internet connection?', 'Only to start the trial, to activate your license key, and for a brief license check about once a month. Writing, editing, exporting and local backups all work completely offline.'],
  ['How many computers can I use it on?', 'Up to 3 on one license. Moving to a new computer? Use Help → Deactivate License on the old one to free up the slot.'],
  ['Can I get a refund?', 'Yes — within 30 days, no questions asked. Email support@ravenburst.com. Once refunded, the license key is deactivated.'],
  ['Is there a student discount?', 'Not yet. The one-time price is intentionally affordable — we’d rather you own it than feel like you’re renting it.'],
]
---
<Base title="Pricing" description="Ravenburst is a one-time purchase: $39, no subscription, free updates through version 2. Kickstarter backers get free upgrades through version 3.">
  <Nav />
  <main id="main" class="pt-32 pb-20 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Simple, honest pricing.</h1>
      <p class="text-rb-muted text-xl max-w-xl mx-auto">Buy once. Own it. No subscription, ever.</p>
    </div>

    <!-- Planned price -->
    <div class="max-w-md mx-auto bg-rb-surface border-2 border-rb-accent rounded-2xl p-8 mb-12 text-center">
      <div class="text-rb-muted text-sm uppercase tracking-widest mb-2">Ravenburst</div>
      <div class="text-5xl font-bold text-rb-text mb-2">$39</div>
      <div class="text-rb-muted text-sm mb-8">one-time · planned price at release</div>
      <ul class="text-left space-y-3 mb-8 text-sm text-rb-muted">
        {included.map(f => (
          <li class="flex items-start gap-3">
            <span class="text-rb-green mt-0.5" aria-hidden="true">✓</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <div class="text-left">
        <p class="text-sm text-rb-text font-medium mb-3">Coming to Kickstarter first — get the launch email:</p>
        <SignupForm id="signup-pricing" source="pricing" />
      </div>
    </div>

    <!-- Upgrade path -->
    <div class="bg-rb-surface border border-rb-border rounded-2xl p-8 mb-12">
      <h2 class="text-xl font-serif font-semibold mb-6">How upgrades work</h2>
      <div class="grid md:grid-cols-3 gap-6 text-sm text-rb-muted">
        <div>
          <h3 class="text-rb-text font-semibold mb-2 font-sans">Kickstarter backers</h3>
          Free through version 3, plus every patch.
        </div>
        <div>
          <h3 class="text-rb-text font-semibold mb-2 font-sans">Version 1 buyers</h3>
          Version 2 included free. Patches are always free.
        </div>
        <div>
          <h3 class="text-rb-text font-semibold mb-2 font-sans">Future versions</h3>
          A small upgrade price, never forced — what you own keeps working.
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <section aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-serif font-semibold mb-6">Common questions</h2>
      <div class="space-y-4">
        {faqs.map(([q, a]) => (
          <details class="bg-rb-surface border border-rb-border rounded-xl p-5 group">
            <summary class="font-medium text-rb-text cursor-pointer list-none flex justify-between items-center gap-4">
              {q}
              <span class="text-rb-muted group-open:rotate-180 transition-transform" aria-hidden="true">↓</span>
            </summary>
            <p class="mt-3 text-rb-muted text-sm leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
