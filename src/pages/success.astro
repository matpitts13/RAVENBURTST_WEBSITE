---
// Shown after a purchase (wired up when sales open after the Kickstarter).
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
---
<Base title="Thank you" description="Thank you for buying Ravenburst. Your activation code is on its way.">
  <Nav />
  <main id="main" class="pt-32 pb-20 px-6 max-w-xl mx-auto text-center">
    <img src="/brand/raven.svg" alt="" width="110" height="128" class="w-24 h-auto mx-auto mb-8" />
    <h1 class="text-4xl font-serif font-bold mb-4">You’re in.</h1>
    <p class="text-rb-muted text-lg mb-10">
      Your activation code is on its way to your inbox. If it hasn’t arrived in a few minutes, check your spam folder.
    </p>
    <div class="bg-rb-surface border border-rb-border rounded-2xl p-8 text-left">
      <h2 class="font-serif text-xl font-semibold mb-4">Getting started</h2>
      <ol class="space-y-3 text-rb-muted list-decimal list-inside">
        <li><a href="/download" class="text-rb-accent hover:underline">Download Ravenburst</a> for your computer</li>
        <li>Install and open it</li>
        <li>Choose Help → Enter Activation Code</li>
        <li>Enter your email address and the code from your inbox</li>
      </ol>
    </div>
    <p class="text-rb-muted text-sm mt-8">Questions? <a href="mailto:support@ravenburst.com" class="text-rb-accent hover:underline">support@ravenburst.com</a></p>
  </main>
  <Footer />
</Base>
