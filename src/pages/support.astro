---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const faqs: [string, string][] = [
  ['How do I install Ravenburst?', 'Download the installer for your platform. On Windows, run the .exe. On macOS, open the .dmg and drag Ravenburst to Applications. On Linux, use the .deb or .rpm package, or make the AppImage executable and run it.'],
  ['Where are my projects saved?', 'Each project is a single .ravenburst file, saved in Documents\\Ravenburst by default. You can save it anywhere, and copy or move it like any other file.'],
  ['How do I back up my work?', 'Use File → Save as Snapshot to keep named versions of a document, and set up Git Backup (Project → Git Backup…) to back up the whole project automatically to a folder, a drive or a service like GitHub. See the documentation for step-by-step help.'],
  ['How do I enter my activation code?', 'Choose Help → Enter Activation Code, or open Preferences → License. Enter the email address you bought with and paste in your code.'],
  ['Does Ravenburst work offline?', 'Yes. Writing, editing, exporting and local backups all work offline. You only need a connection to start the trial, activate your license, and for a brief license check about once a month.'],
  ['What happens when my trial ends?', 'Nothing is deleted or locked away: you can still open, write in and save your projects. Exporting is paused until you enter an activation code.'],
  ['Can I use my license on more than one computer?', 'Yes, on up to 3. To move to a new computer, use Help → Deactivate License on This Device on the old one, then activate on the new one.'],
  ['I lost my activation code. Can I get it again?', 'Yes. Email support@ravenburst.com from the address you bought with and we’ll send it again.'],
]
---
<Base title="Support" description="Answers to common Ravenburst questions, and how to reach us.">
  <Nav />
  <main id="main" class="pt-32 pb-20 px-6 max-w-3xl mx-auto">
    <div class="text-center mb-14">
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Support</h1>
      <p class="text-rb-muted text-xl">
        Find an answer below, check the <a href="/docs" class="text-rb-accent hover:underline">documentation</a>, or email us.
      </p>
    </div>

    <section aria-labelledby="faq" class="mb-16">
      <h2 id="faq" class="text-2xl font-serif font-semibold mb-6">Common questions</h2>
      <div class="space-y-4">
        {faqs.map(([q, a]) => (
          <details class="bg-rb-surface border border-rb-border rounded-xl p-5 group">
            <summary class="font-medium text-rb-text cursor-pointer list-none flex justify-between items-center gap-4">
              {q}
              <span class="text-rb-muted group-open:rotate-180 transition-transform" aria-hidden="true">↓</span>
            </summary>
            <p class="mt-3 text-rb-muted text-sm leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-rb-surface border border-rb-border rounded-2xl p-8 text-center" aria-labelledby="contact">
      <h2 id="contact" class="text-xl font-serif font-semibold mb-3">Still stuck?</h2>
      <p class="text-rb-muted mb-6">Email us and a real person will reply, usually within a day or two.</p>
      <a href="mailto:support@ravenburst.com"
        class="inline-block bg-rb-accent hover:bg-rb-accent-hv text-white px-6 py-3 rounded-lg font-medium transition-colors">
        support@ravenburst.com
      </a>
      <p class="text-rb-muted text-sm mt-4">
        Reporting a bug? In the app, Help → Report a Bug fills in your version details for you.
      </p>
    </section>
  </main>
  <Footer />
</Base>
